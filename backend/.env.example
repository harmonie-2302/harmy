# ===================================================================
# HARMY'SEWING BACKEND - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ===================================================================

# 1. Base de données PostgreSQL Local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/harmy_swing
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=2025

# 2. Sécurité Spring Security & JWT (Clé secrète de signature)
JWT_SECRET=replace_with_a_long_random_secret

# 3. Stockage d'images Cloudflare R2 / AWS S3 API
CLOUDFLARE_R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=harmyswing
CLOUDFLARE_R2_ACCESS_KEY=your_access_key_id_here
CLOUDFLARE_R2_SECRET_KEY=your_secret_access_key_here
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# 4. Configuration Serveur Spring Boot
PORT=8080

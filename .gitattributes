# Normalisation des fins de ligne.
# Sans cette règle, les fichiers créés sous Windows partent en CRLF et Linux
# refuse d'exécuter les scripts (« bad interpreter: /usr/bin/env bash^M »).
* text=auto

# Doivent impérativement rester en LF : exécutés sur le serveur Ubuntu.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
Dockerfile      text eol=lf
.env.example    text eol=lf

# Fichiers binaires : aucune conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.jar  binary
*.woff  binary
*.woff2 binary

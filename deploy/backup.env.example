# Copier vers /etc/harmy/backup.env, proprietaire root:root, mode 600.
# Ne jamais versionner le fichier rempli.

# ATTENTION : les archives ne sont volontairement PAS chiffrees. Elles
# contiennent notamment backend.env et les secrets applicatifs en clair.
# Protegez strictement le compte Google Drive et ses telechargements.

# Envoi hors fournisseur via Google Drive et OAuth rclone. Le script
# setup-rclone-backup.sh affiche le lien Google et configure ces valeurs.
HARMY_RCLONE_ENABLED=false
HARMY_RCLONE_REMOTE=harmy-drive
HARMY_RCLONE_PATH=Harmy-Swing-Backups
HARMY_RCLONE_CONFIG=/etc/harmy/rclone.conf
